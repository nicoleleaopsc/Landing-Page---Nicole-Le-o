  <section class="faixa">
    <div class="cont coluna pol">
      <nav class="pol-indice" aria-label="Itens desta política">
        <ol>
          <li><a href="#responsavel">Responsável pelo tratamento</a></li>
          <li><a href="#dados-coletados">Dados coletados</a></li>
